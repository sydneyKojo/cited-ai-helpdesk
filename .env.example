PORT=3300
DATABASE_URL=postgres://localhost:5432/helpdesk
TEST_DATABASE_URL=postgres://localhost:5432/helpdesk_test
# api: needs ANTHROPIC_API_KEY. claude-code: uses your local Claude Code login (no key).
LLM_PROVIDER=api
ANTHROPIC_API_KEY=
# Bearer token for the ticket inbox at /admin.
ADMIN_TOKEN=change-me

# Set to true only behind a reverse proxy you control (uses X-Forwarded-For for rate limiting).
TRUST_PROXY=false

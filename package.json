{
  "name": "ai-helpdesk",
  "version": "1.0.0",
  "private": true,
  "description": "AI help-desk assistant that answers from a company's own docs with citations and hands off to a human when unsure.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:setup": "tsx src/cli.ts setup",
    "ingest": "tsx src/cli.ts ingest knowledge",
    "ask": "tsx src/cli.ts ask",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "seed": "tsx scripts/seed-demo.ts",
    "db:prepare": "tsx scripts/prepare.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@hono/node-server": "^2.1.3",
    "dotenv": "^18.0.5",
    "hono": "^4.13.12",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
